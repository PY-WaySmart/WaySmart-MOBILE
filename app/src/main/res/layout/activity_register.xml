<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#155799">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Ícono oficial WaySmart -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_waysmart_logo"
            android:contentDescription="WaySmart Logo"
            android:layout_marginBottom="4dp" />

        <!-- Nombre de la app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WaySmart"
            android:textColor="#E2E8F0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="28dp" />

        <!-- Nombre completo -->
        <EditText
            android:id="@+id/etNombreCompleto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Nombre completo"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="24dp"
            android:background="@drawable/bg_edittext_rounded"
            android:textColor="#1E293B"
            android:textColorHint="#64748B"
            android:textSize="15sp"
            android:layout_marginBottom="14dp" />

        <!-- Correo electrónico -->
        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="24dp"
            android:background="@drawable/bg_edittext_rounded"
            android:textColor="#1E293B"
            android:textColorHint="#64748B"
            android:textSize="15sp"
            android:layout_marginBottom="14dp" />

        <!-- Teléfono -->
        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Teléfono"
            android:inputType="phone"
            android:paddingHorizontal="24dp"
            android:background="@drawable/bg_edittext_rounded"
            android:textColor="#1E293B"
            android:textColorHint="#64748B"
            android:textSize="15sp"
            android:layout_marginBottom="14dp" />

        <!-- Tipo de vehículo (Spinner) -->
        <Spinner
            android:id="@+id/spinnerTipoVehiculo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_edittext_rounded"
            android:paddingHorizontal="16dp"
            android:popupBackground="#FFFFFF"
            android:textColorHint="#64748B"
            android:layout_marginBottom="14dp" />

        <!-- Placa -->
        <EditText
            android:id="@+id/etPlaca"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Placa"
            android:inputType="textCapCharacters"
            android:maxLength="7"
            android:paddingHorizontal="24dp"
            android:background="@drawable/bg_edittext_rounded"
            android:textColor="#1E293B"
            android:textColorHint="#64748B"
            android:textSize="15sp"
            android:layout_marginBottom="26dp" />

        <!-- Botón Registrarse centrado -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegistrarse"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="Registrarse"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary"
            android:elevation="2dp"
            android:layout_marginBottom="22dp" />

        <!-- Enlace a Login -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes cuenta? "
                android:textColor="#E2E8F0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvYaTienesCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicia sesión"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingVertical="6dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>